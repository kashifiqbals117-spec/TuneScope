# ==============================================================================
# TuneScope - Backend Environment Variables (.env.example)
# Copy this file to 'backend/.env' (or root '.env') for local backend development.
# NEVER commit your actual '.env' files or production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking Configuration
# ------------------------------------------------------------------------------
# PORT: Port on which the Express server listens.
# Type: Optional (Defaults to 5000 if not specified)
PORT=5000

# NODE_ENV: Application environment mode ('development', 'production', or 'test').
# Type: Optional (Defaults to 'development')
NODE_ENV=development

# FRONTEND_URL: Base URL of the client application.
# Used by Spotify OAuth redirect callbacks to return users to the frontend.
# Type: Mandatory
# Local Dev:  http://127.0.0.1:5173
# Production: https://tunescope.vercel.app (or your production Vercel domain)
FRONTEND_URL=http://127.0.0.1:5173

# CORS_ORIGINS: Comma-separated list of allowed origins for HTTP requests and Socket.IO.
# Type: Optional (Defaults to http://127.0.0.1:5173,http://localhost:5173)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + Prisma ORM)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection URI.
# Every collaborator should run a local PostgreSQL instance or private dev database.
# NEVER point local development to the team's shared production database!
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>?schema=public
#
# Type: Mandatory
# Local Dev:  postgresql://postgres:your_password@127.0.0.1:5432/tunescope?schema=public
# Production: postgresql://user:pass@host.render.com/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tunescope?schema=public

# TEST_DATABASE_URL: Isolated PostgreSQL database used for automated Vitest suites.
# Type: Optional (Falls back to DATABASE_URL if omitted)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tunescope_test?schema=public

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens.
# Must be at least 32 characters long.
# Type: Mandatory
# In production, generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters!

# JWT_EXPIRES_IN: Lifespan of generated user session tokens.
# Type: Optional (Defaults to '7d')
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Official Spotify Web API Integration
# ------------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard to obtain credentials.
#
# IMPORTANT SPOTIFY POLICY REQUIREMENT:
# Spotify's OAuth system strictly disallows 'localhost'. Use '127.0.0.1'.
# In Spotify App settings -> Redirect URIs, you MUST add:
# Local Development: http://127.0.0.1:5000/api/spotify/callback
# Production:        https://<your-render-domain>/api/spotify/callback
#
# SPOTIFY_CLIENT_ID: Your Spotify Developer Application Client ID.
# Type: Mandatory for Spotify features (App will run in demo-mode if omitted)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# SPOTIFY_CLIENT_SECRET: Your Spotify Developer Application Client Secret.
# Type: Mandatory for Spotify features
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# SPOTIFY_REDIRECT_URI: Exact URI registered in Spotify Developer Dashboard.
# Type: Mandatory
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback

# SPOTIFY_SCOPES: Space-separated OAuth scopes requested during authorization.
# Type: Optional (Defaults to standard listening history & profile scopes)
SPOTIFY_SCOPES=user-read-recently-played user-top-read user-read-playback-state user-read-currently-playing user-read-email user-read-private

# ------------------------------------------------------------------------------
# 5. Cloudinary Media Storage (Optional / Extensible)
# ------------------------------------------------------------------------------
# If you are implementing direct image uploads for custom user avatars:
# Obtain these credentials at https://cloudinary.com/console
# Type: Optional (TuneScope currently supports direct image URLs out of the box)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Performance
# ------------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS: Window size in milliseconds for rate limiting.
# Type: Optional (Defaults to 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# RATE_LIMIT_MAX_REQUESTS: Maximum number of requests allowed per window.
# Type: Optional (Defaults to 200)
RATE_LIMIT_MAX_REQUESTS=200
