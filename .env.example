# ==============================================================================
# TuneScope - Environment Variables Configuration Template
# Copy this file to '.env' in the project root and in 'backend/.env'
# NEVER commit your actual '.env' files or production credentials to Git.
# ==============================================================================

# Application & Server Configuration
PORT=5000
NODE_ENV=development # 'development' locally, 'production' on Render
FRONTEND_URL=http://127.0.0.1:5173 # Set to your deployed Vercel domain in production, e.g. https://tunescope.vercel.app
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://tunescope.vercel.app

# Frontend Environment Variables (in frontend/.env or Vercel dashboard)
# In production, point VITE_API_URL to your Render web service backend URL
# VITE_API_URL=https://tunescope-backend.onrender.com

# Database Connection (PostgreSQL)
# Local: postgresql://postgres:password@127.0.0.1:5432/tunescope?schema=public
# Production (Render/Neon/Supabase): postgresql://user:password@hostname:5432/tunescope?sslmode=require
DATABASE_URL=postgresql://postgres:your_local_password@127.0.0.1:5432/tunescope?schema=public
TEST_DATABASE_URL=postgresql://postgres:your_local_password@127.0.0.1:5432/tunescope_test?schema=public

# Authentication & Security
# Generate a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters!
JWT_EXPIRES_IN=7d

# Official Spotify Web API Integration
# Create an application in Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# Note: Spotify strictly requires 127.0.0.1 instead of localhost for local OAuth redirects.
# In production, add https://<your-render-domain>/api/spotify/callback to your Spotify App's Redirect URIs.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback
SPOTIFY_SCOPES=user-read-recently-played user-top-read user-read-playback-state user-read-currently-playing user-read-email user-read-private

# Rate Limiting & Performance
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
