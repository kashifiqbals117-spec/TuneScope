# ==============================================================================
# TuneScope - Environment Variables Configuration
# Copy this file to '.env' in the project root and backend/.env
# ==============================================================================

# Application & Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL=postgresql://postgres:kashif._.0611@127.0.0.1:5432/tunescope?schema=public
TEST_DATABASE_URL=postgresql://postgres:kashif._.0611@127.0.0.1:5432/tunescope_test?schema=public

# Authentication & Security
# Generate a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=tunescope-super-secure-jwt-secret-key-32-chars-min!
JWT_EXPIRES_IN=7d

# Official Spotify Web API Integration
# Create an application in Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# Add http://127.0.0.1:5000/api/spotify/callback to your Spotify App's Redirect URIs (Spotify requires 127.0.0.1 instead of localhost)
SPOTIFY_CLIENT_ID=74ea27f4996748eebfc1d250618499e4
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback
# Permissions: user-read-recently-played, user-top-read, user-read-playback-state, user-read-currently-playing
SPOTIFY_SCOPES=user-read-recently-played user-top-read user-read-playback-state user-read-currently-playing user-read-email user-read-private

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

