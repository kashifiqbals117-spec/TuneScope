# ==============================================================================
# TuneScope - Monorepo Master Environment Variables (.env.example)
# Copy this file to '.env' in the project root and/or 'backend/.env'.
# Frontend-specific variables can also be placed in 'frontend/.env'.
# NEVER commit your actual '.env' files or production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Frontend API Target (Vite)
# Point to your local backend (http://127.0.0.1:5000) or leave blank for relative /api proxy
VITE_API_URL=http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (Prisma)
# ------------------------------------------------------------------------------
# Local Development: postgresql://<user>:<pass>@127.0.0.1:5432/tunescope?schema=public
# Production:        postgresql://<user>:<pass>@<host>:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tunescope?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tunescope_test?schema=public

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_characters!
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Spotify Developer Web API
# ------------------------------------------------------------------------------
# Register your app at: https://developer.spotify.com/dashboard
# Redirect URI MUST be exact: http://127.0.0.1:5000/api/spotify/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/api/spotify/callback
SPOTIFY_SCOPES=user-read-recently-played user-top-read user-read-playback-state user-read-currently-playing user-read-email user-read-private

# ------------------------------------------------------------------------------
# 5. Cloudinary Media Storage (Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. Rate Limiting
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
