# ==============================================================================
# TuneScope - Frontend Environment Variables (.env.example)
# Copy this file to 'frontend/.env' for local development overrides.
# In production (e.g. Vercel), configure these in your Project Settings > Environment Variables.
# ==============================================================================

# Backend API URL
# ------------------------------------------------------------------------------
# Type: Optional in Development / Mandatory in Production
#
# Development:
# Set to 'http://127.0.0.1:5000' to point directly to your local Express backend.
# If omitted or left empty, the application falls back to relative '/api' routing.
#
# Production (Vercel):
# Must be set to your live deployed backend URL (no trailing slash).
# Example: https://tunescope-backend.onrender.com
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:5000
